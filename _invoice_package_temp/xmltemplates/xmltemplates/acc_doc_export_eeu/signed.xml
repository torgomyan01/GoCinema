<ExportedAccDocData xmlns="http://www.taxservice.am/tp3/invoice/definitions">
  <SignedAccDocData>
    <Data>
      <SignableData xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="AccountingDocument" Version="1.0">
        <User>{user|String}</User>
        <Type>{type|Number}</Type>
        <GeneralInfo>
          <EcrReceipt>{crmNo|String}</EcrReceipt>
          <InvoiceNumber>
            <Number>{invoiceNumber|String}</Number>
            <Series>{invoiceSeries|String}</Series>
          </InvoiceNumber>
          <DeliveryDate>{deliveredAt|Date}</DeliveryDate>
          <Procedure>{behalfOf|tax.model.BehalfOf|1:TAXPAYER|2:PRINCIPAL}</Procedure>
          <DealInfo>
            <DealDate>{dealtAt|Date}</DealDate>
            <DealNumber>{dealNo|String}</DealNumber>
            <DealAdditionalData>{contractAdditionalInfo|String}</DealAdditionalData>
            <DealAdditionalDataRu>{contractAdditionalInfoRu|String}</DealAdditionalDataRu>
          </DealInfo>
        </GeneralInfo>
        <SupplierInfo>
          <VATNumber>{supplierVatTin|String}</VATNumber>
          <Taxpayer>
            <TIN>{supplierTin|String}</TIN>
            <Name>{supplierName|String}</Name>
            <NameRu>{supplierNameRu|String}</NameRu>
            <Address>{supplierAddress|String}</Address>
            <AddressRu>{supplierAddressRu|String}</AddressRu>
            <BankAccount>
              <BankName>{supplierBank|String}</BankName>
              <BankNameRu>{supplierBankRu|String}</BankNameRu>
              <BankAccountNumber>{supplierAccNo|String}</BankAccountNumber>
            </BankAccount>
            <AdditionalData>{supplierAdditionalInfo|String}</AdditionalData>
            <AdditionalDataRu>{supplierAdditionalInfoRu|String}</AdditionalDataRu>
            <!-- CredentialNumber is available only in the form "onBehalfOfbeneficiary" -->
            <CredentialsNumber>{poaNumber|String}</CredentialsNumber>
          </Taxpayer>
          <!-- SupplyLocation is available only in the form "onBehalfOfBeneficiary" -->
          <SupplyLocation>{sourceFullAddress|String}</SupplyLocation>
          <SupplyLocationRu>{sourceAddressRu|String}</SupplyLocationRu>
        </SupplierInfo>
        <BuyerInfo>
          <Taxpayer>
            <TIN>{buyerTin|String}</TIN>
            <Passport>{buyerIdentityNo|String}</Passport>
            <PIDType>{buyerIdentityType|String}</PIDType>
            <Name>{buyerName|String}</Name>
            <NameRu>{buyerNameRu|String}</NameRu>
            <FullName>{buyerFullName|String}</FullName>
            <FullNameRu>{buyerFullNameRu|String}</FullNameRu>
            <Address>{buyerAddress|String}</Address>
            <AddressRu>{buyerAddressRu|String}</AddressRu>
            <BankAccount>
              <BankName>{buyerBank|String}</BankName>
              <BankNameRu>{buyerBankRu|String}</BankNameRu>
              <BankAccountNumber>{buyerAccNo|String}</BankAccountNumber>
              <BankAdditionalData>{buyerBankAdditionalInfo|String}</BankAdditionalData>
              <BankAdditionalDataRu>{buyerBankAdditionalInfoRu|String}</BankAdditionalDataRu>
            </BankAccount>
            <AdditionalData>{buyerAdditionalInfo|String}</AdditionalData>
            <AdditionalDataRu>{buyerAdditionalInfoRu|String}</AdditionalDataRu>
            <IsNatural>{buyerIsNatural|Boolean}</IsNatural>
            <PSNOrAbsence>{buyerSsn|String}</PSNOrAbsence>
          </Taxpayer>
          <Mediator>
            <Name>{authPersonName|String}</Name>
            <NameRu>{authPersonNameRu|String}</NameRu>
            <LicenseNumber>{authPersonPoaNo|String}</LicenseNumber>
            <LicenseDate>{authPersonPoaIssuedAt|Date}</LicenseDate>
          </Mediator>
          <DeliveryMethod>{deliveryMethod|String}</DeliveryMethod>
          <DeliveryAdditionalData>{deliveryAdditionalInfo|String}</DeliveryAdditionalData>
          <DeliveryAdditionalDataRu>{deliveryAdditionalInfoRu|String}</DeliveryAdditionalDataRu>
          <EeuCountry>{buyerCountry|String}</EeuCountry>
          <DestinationLocation>{destinationAddress|String}</DestinationLocation>
          <DestinationLocationRu>{destinationAddressRu|String}</DestinationLocationRu>
        </BuyerInfo>
        <GoodsInfo>
          <Good>
            <shownextif field="dummy_value" value="1"/>
            <GoodId>{id|String}</GoodId>
            <Description>{name|String}</Description>
            <DescriptionRu>{nameRu|String}</DescriptionRu>
            <Unit>{unit|String}</Unit>
            <UnitRu>{unitRu|String}</UnitRu>
            <!-- Amount relates to Quantity => confirmed with Harut -->
            <Amount>{quantity|Number4}</Amount>
            <PricePerUnit>{unitPrice|Number5}</PricePerUnit>
            <!-- TODO!!! is Price == PricePerUnit-->
            <Price>{totalValue|Number}</Price>
            <Discount>{discount|Number4}</Discount>
            <GoodTraceableInfo>
              <PreviousDocumentNumber>{previousDocumentNumber|String}</PreviousDocumentNumber>
              <PreviousDocumentType>{previousDocumentType|String}</PreviousDocumentType>
              <SeqNoByPreviousDoc>{seqNoByPreviousDoc|String}</SeqNoByPreviousDoc>
              <ProductFEACNCode>{productFEACNCode|String}</ProductFEACNCode>
              <QuantityByFEACN>{quantityByFEACN|Number}</QuantityByFEACN>
              <UnitByFEACNCode>{unitByFEACNCode|String}</UnitByFEACNCode>
            </GoodTraceableInfo>
          </Good>
          <Total>
            <!-- Total of all goods. This is property of AccDocServices entity-->
            <TotalPrice>{totalValue|Number}</TotalPrice>
          </Total>
        </GoodsInfo>
      </SignableData>
    </Data>
    <Signature>
      <SignatureType>PKCS7</SignatureType>
      <SignatureValue>{supplierSignature|String}</SignatureValue>
    </Signature>
    <shownextif field="showbs" value="1"/>
    <renamenext field="Signature" />
    <bSignature>
      <SignatureType>PKCS7</SignatureType>
      <SignatureValue>{buyerSignature|String}</SignatureValue>
    </bSignature>
    <AccDocMetadata>
      <SubmissionDate>{supplierSignedAt|DateTime}</SubmissionDate>
      <CoSignDate>{buyerSignedAt|DateTime}</CoSignDate>
    </AccDocMetadata>
  </SignedAccDocData>
</ExportedAccDocData>
