<ExportedData xmlns="http://www.taxservice.am/tp3/invoice/definitions">
  <Invoice Version="1.0">
    <Type>{type|Number}</Type>
    <GeneralInfo>
      <EcrReceipt>{crmNo|String}</EcrReceipt>
      <!-- Form is not correctable -->
      <InvoiceNumber>
        <Number>{invoiceNumber|String}</Number>
        <Series>{invoiceSeries|String}</Series>
      </InvoiceNumber>
      <SupplyDate>{deliveredAt|Date}</SupplyDate>
      <Procedure>2</Procedure>
      <DealInfo>
        <DealDate>{dealtAt|Date}</DealDate>
        <DealNumber>{dealNo|String}</DealNumber>
      </DealInfo>
      <AdditionalData>{additionalInfo|String}</AdditionalData>
      <!-- Form is not correctable -->
    </GeneralInfo>
    <SupplierInfo>
      <VATNumber>{lessorVatTin|String}</VATNumber>
      <Taxpayer>
        <TIN>{lessorTin|String}</TIN>
        <Name>{lessorName|String}</Name>
        <Address>{lessorAddress|String}</Address>
        <BankAccount>
          <BankName>{lessorBank|String}</BankName>
          <BankAccountNumber>{lessorAccNo|String}</BankAccountNumber>
        </BankAccount>
        <AdditionalData>{lessorAdditionalInfo|String}</AdditionalData>
      </Taxpayer>
      <SupplyLocation>{deliveryFullAddress|String}</SupplyLocation>
      <FactualSupplierAddress>{lessorFullAddress|String}</FactualSupplierAddress>
    </SupplierInfo>
    <BuyerInfo>
      <VATNumber>{lesseeVatTin|String}</VATNumber>
      <Taxpayer>
        <TIN>{lesseeTin|String}</TIN>
        <Passport>{lesseeIdentityNo|String}</Passport>
        <PIDType>{lesseeIdentityType|String}</PIDType>
        <Name>{lesseeName|String}</Name>
        <Address>{lesseeAddress|String}</Address>
        <BankAccount>
          <BankName>{lesseeBank|String}</BankName>
          <BankAccountNumber>{lesseeAccNo|String}</BankAccountNumber>
        </BankAccount>
        <AdditionalData>{lesseeAdditionalInfo|String}</AdditionalData>
        <TinNotRequired>{lesseeHasNoTin|Boolean}</TinNotRequired>
        <IsNatural>{lesseeIsNatural|Boolean}</IsNatural>
        <PSNOrAbsence>{lesseeSsn|String}</PSNOrAbsence>
      </Taxpayer>
      <Mediator>
        <Name>{authPersonName|String}</Name>
        <LicenseNumber>{authPersonPoaNo|String}</LicenseNumber>
        <LicenseDate>{authPersonPoaIssuedAt|Date}</LicenseDate>
      </Mediator>
      <DeliveryLocation>{destinationFullAddress|String}</DeliveryLocation>
      <BuyerResidenceAddress>{lesseeResidenceAddress|String}</BuyerResidenceAddress>
      <FactualBuyerAddress>{lesseeFullAddress|String}</FactualBuyerAddress>
    </BuyerInfo>
    <GoodsInfo>
      <Good>
        <shownextif field="dummy_value" value="1"/>
        <GoodId>{id|String}</GoodId>
        <Description>{name|String}</Description>
        <Unit>{unit|String}</Unit>
        <Amount>{quantity|Number4}</Amount>
        <PricePerUnit>{unitPrice|Number5}</PricePerUnit>
        <Price>{totalValue|Number}</Price>
        <VATRate>{vatRate|tax.model.VatRate|0.0:NONE|20.0:VAT_20}</VATRate>
        <VAT>{vatAmount|Number}</VAT>
        <TotalPrice>{total|Number}</TotalPrice>
      </Good>
      <Total>
        <Price>{totalValue|Number}</Price>
        <VAT>{totalVatAmount|Number}</VAT>
        <TotalPrice>{total|Number}</TotalPrice>
      </Total>
    </GoodsInfo>
  </Invoice>
</ExportedData>
