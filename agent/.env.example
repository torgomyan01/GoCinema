# HTTP server (դրամարկղի համակարգչում — միայն localhost)
AGENT_HOST=127.0.0.1
AGENT_PORT=3100
AGENT_API_KEY=change-me-to-random-secret

# CORS — production + լոկալ dev
AGENT_ALLOW_ORIGIN=https://gocinema.am,http://localhost:3000,http://127.0.0.1:3000

# ՀԴՄ սարք (տեղական ցանց)
HDM_HOST=192.168.123.6
HDM_PORT=8080
HDM_PASSWORD=12345678

# Օպերատոր (GET /v1/operators → c[].id) և PIN
HDM_CASHIER=3
HDM_PIN=

# Լռելյայն ԱՏԳ կոդեր (taxservice.am)
HDM_DEFAULT_DEP=1
HDM_DEFAULT_ADG_TICKET=05213
HDM_DEFAULT_ADG_PRODUCT=0104

# Քարտով վաճառք՝ արտաքին POS
HDM_USE_EXT_POS=true
