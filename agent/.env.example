# HTTP server (դրամարկղի համակարգչում — միայն localhost)
AGENT_HOST=127.0.0.1
AGENT_PORT=3100
AGENT_API_KEY=change-me-to-random-secret

# CORS — production + լոկալ dev
AGENT_ALLOW_ORIGIN=https://gocinema.am,https://www.gocinema.am,http://localhost:3000,http://127.0.0.1:3000

# ՀԴՄ սարք (տեղական ցանց)
HDM_HOST=192.168.123.6
HDM_PORT=8080
HDM_PASSWORD=12345678

# Օպերատոր (GET /v1/operators → c[].id) և PIN
HDM_CASHIER=3
HDM_PIN=

# Բաժիններ (GET /v1/operators → d[].id)
HDM_DEFAULT_DEP=1
HDM_DEP_TICKET=1
HDM_DEP_PRODUCT=2

# Լռելյայն ԱՏԳ/ԱԴԳՏ կոդեր (4 նիշ, առանց կետի — src.am N 875-Ն / N 1406-Ն)
# Տոմս — N 875-Ն 59.14 Կինոթատրոնների ցուցադրման ծառայություններ
HDM_DEFAULT_ADG_TICKET=59.14
# Ապրանք — տող 123: Մանրածախ առևտրի ծառայություններ
HDM_DEFAULT_ADG_PRODUCT=47.00

# Քարտով վաճառք
# false = ՀԴՄ ներքին անկանխիկ էկրան/տերմինալ
# true  = արտաքին POS (առանց ՀԴՄ տերմինալի)
HDM_USE_EXT_POS=false
# Optional: 1=Քարտային, 10=ԹԵԼ-ՍԵԼ, 13=ԻԴՐԱՄ (դատարկ = ընտրություն ՀԴՄ-ում)
HDM_PAYMENT_SYSTEM=
