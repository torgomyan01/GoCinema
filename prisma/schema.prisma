generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// User Management
// ============================================

model User {
  id             Int       @id @default(autoincrement())
  email          String?   @unique @db.VarChar(255)
  name           String?   @db.VarChar(255)
  phone          String    @unique @db.VarChar(50)
  password       String    @db.VarChar(255)
  birthDate      DateTime? @db.Date // ծննդյան ամսաթիվ
  role           String    @default("user") @db.VarChar(50) // user, admin, moderator, employee, producer (comma-separated roles supported in app code)
  emailVerified  Boolean   @default(false)
  phoneVerified  Boolean   @default(false)
  avatar         String?   @db.VarChar(500)
  telegramChatId String?   @db.VarChar(100) // Telegram chat ID for OTP delivery
  isBlocked      Boolean   @default(false) // արգելափակված է անվճար ամրագրումից (no-show-ի պատճառով)
  blockedAt      DateTime? // երբ է արգելափակվել
  /// Կայքում գրանցում/ակտիվացում (null = միայն դրամարկղային բոնուսային հաշիվ)
  webRegisteredAt DateTime?

  // ── Բոնուսային համակարգ ──────────────────────────────────────────────────
  bonusPoints       Int       @default(0) // ընթացիկ մնացորդ (միշտ = ledger-ի գումար)
  bonusTier         String    @default("silver") @db.VarChar(20) // silver, gold, platinum
  bonusVisits       Int       @default(0) // վճարված այցեր՝ մակարդակի հաշվարկի համար
  referralCode      String?   @unique @db.VarChar(20) // սեփական հրավերի կոդ
  referredById      Int? // ո՞վ է հրավիրել
  welcomeBonusAt    DateTime? // welcome բոնուսը տրվել է
  birthdayBonusYear Int? // ո՞ր տարվա ծննդյան բոնուսն է տրված

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tickets             Ticket[]
  payments            Payment[]
  reviews             Review[]
  orders              Order[]
  contacts            Contact[]
  passwordResetTokens PasswordResetToken[]
  supportRequests     SupportRequest[]
  producedMovies      Movie[]              @relation("MovieProducers")
  fiscalReceipts      FiscalReceipt[]      @relation("CashierFiscalReceipts")
  expenses            Expense[]            @relation("ExpenseCreatedBy")
  taxDocuments        TaxDocument[]        @relation("TaxDocumentCreatedBy")
  packageBookings     PackageBooking[]     @relation("PackageBookingCreatedBy")

  referredBy               User?              @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                User[]             @relation("UserReferrals")
  bonusTransactions        BonusTransaction[] @relation("BonusOwner")
  bonusTransactionsCreated BonusTransaction[] @relation("BonusCreatedBy")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([telegramChatId])
  @@index([referralCode])
  @@index([referredById])
  @@index([bonusTier])
  @@map("users")
}

model PasswordResetToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @db.VarChar(64) // 6-digit OTP or 32-char session token
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_reset_tokens")
}

// SMS վերիֆիկացիայի կոդեր (Dexatel)՝ գրանցման համար
model PhoneVerification {
  id        Int      @id @default(autoincrement())
  phone     String   @db.VarChar(50)
  code      String   @db.VarChar(8)
  purpose   String   @default("register") @db.VarChar(30) // register
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([phone])
  @@index([phone, purpose])
  @@map("phone_verifications")
}

// ============================================
// Movies
// ============================================

model Movie {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255)
  slug        String?  @unique @db.VarChar(255)
  image       String?  @db.VarChar(500)
  duration    Int // minutes
  rating      Float    @default(0)
  ageRating   String?  @db.VarChar(10) // 0+, 6+, 12+, 16+, 18+ (null = not specified)
  genre       String   @db.VarChar(100)
  releaseDate DateTime
  description String?  @db.Text
  trailerUrl  String?  @db.VarChar(500)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  screenings Screening[]
  reviews    Review[]
  premieres  Premiere[]
  producers  User[]      @relation("MovieProducers")

  @@index([slug])
  @@index([genre])
  @@index([isActive])
  @@index([releaseDate])
  @@map("movies")
}

// ============================================
// Halls & Seats
// ============================================

model Hall {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  capacity  Int      @default(80)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  seats      Seat[]
  screenings Screening[]

  @@map("halls")
}

model Seat {
  id       Int    @id @default(autoincrement())
  hallId   Int
  row      String @db.VarChar(10)
  number   Int
  seatType String @default("standard") @db.VarChar(50) // standard, vip, disabled

  hall    Hall     @relation(fields: [hallId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@unique([hallId, row, number])
  @@index([hallId])
  @@map("seats")
}

// ============================================
// Screenings
// ============================================

model Screening {
  id        Int      @id @default(autoincrement())
  movieId   Int
  hallId    Int
  startTime DateTime
  endTime   DateTime
  basePrice Float    @default(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movie   Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)
  hall    Hall     @relation(fields: [hallId], references: [id], onDelete: Cascade)
  tickets Ticket[]

  @@index([movieId])
  @@index([hallId])
  @@index([startTime])
  @@map("screenings")
}

// ============================================
// Tickets & Payments
// ============================================

model Ticket {
  id                  Int       @id @default(autoincrement())
  userId              Int
  screeningId         Int
  seatId              Int
  price               Float
  status              String    @default("reserved") @db.VarChar(50) // reserved (դրամարկղ), awaiting_payment (օնլայն՝ սպասում է վճարման), paid, used, cancelled
  qrCode              String?   @db.VarChar(500)
  holdUntil           DateTime? // ամրագրման ժամկետի վերջը. online՝ +10ր, դրամարկղ-ամրագրում՝ ցուցադրության սկիզբը
  noShow              Boolean   @default(false) // դրամարկղ-ամրագրում, որը լրացել է առանց վճարման (չի եկել)
  preparationServedAt DateTime? // նախապատրաստման էջում՝ այս նստատեղի պատվերը սպասարկված է
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  screening         Screening          @relation(fields: [screeningId], references: [id], onDelete: Cascade)
  seat              Seat               @relation(fields: [seatId], references: [id], onDelete: Cascade)
  payment           Payment?
  order             Order?             @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId           Int?
  orderItems        OrderItem[]
  fiscalReceipts    FiscalReceipt[]
  bonusTransactions BonusTransaction[]

  @@index([userId])
  @@index([screeningId])
  @@index([status])
  @@index([orderId])
  @@index([noShow])
  @@index([preparationServedAt])
  @@map("tickets")
}

model Payment {
  id            Int      @id @default(autoincrement())
  userId        Int
  ticketId      Int      @unique
  amount        Float
  amountPaid    Float? // կանխիկ վճարման դեպքում՝ հաճախորդի տված գումարը (մանրը հաշվելու համար)
  method        String   @db.VarChar(50) // card, bank_transfer, cash
  status        String   @default("pending") @db.VarChar(50) // pending, completed, failed, refunded
  transactionId String?  @db.VarChar(255)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([ticketId])
  @@index([status])
  @@map("payments")
}

// ============================================
// ՀԴՄ (PEC) ֆիսկալ կտրոններ
// Ամեն ֆիսկալ գործարք (վաճառք/վերադարձ)՝ ՀԴՄ-ից ստացված ամբողջ պատասխանով։
// status=failed դեպքում պահվում է requestPayload-ը՝ հետագա վերատպման համար։
// ============================================
model FiscalReceipt {
  id            Int     @id @default(autoincrement())
  operation     String  @default("sale") @db.VarChar(20) // sale, return
  source        String  @default("box_office") @db.VarChar(20) // box_office, scanner
  paymentMethod String  @default("cash") @db.VarChar(20) // cash, card
  status        String  @default("printed") @db.VarChar(20) // printed, failed
  errorMessage  String? @db.Text
  errorCode     Int?

  // ՀԴՄ պատասխանի դաշտերը
  rseq               Int?
  fiscalNumber       String?   @db.VarChar(50) // fiscal
  crn                String?   @db.VarChar(50)
  sn                 String?   @db.VarChar(50)
  tin                String?   @db.VarChar(50)
  taxpayer           String?   @db.VarChar(255)
  address            String?   @db.VarChar(500)
  fiscalTime         DateTime? // ՀԴՄ-ի `time` (ms → DateTime)
  lottery            String?   @db.VarChar(50)
  prize              Float?
  total              Float     @default(0)
  change             Float     @default(0)
  qr                 String?   @db.Text
  emarksCount        Int       @default(0)
  verificationNumber String?   @db.VarChar(50)

  // Վերատպման համար՝ agent-ին ուղարկվող սկզբնական հարցումը
  requestPayload Json?

  ticketId  Int?
  orderId   Int?
  cashierId Int?
  ticket    Ticket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  cashier   User?   @relation("CashierFiscalReceipts", fields: [cashierId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([operation])
  @@index([source])
  @@index([ticketId])
  @@index([orderId])
  @@index([cashierId])
  @@index([fiscalNumber])
  @@index([createdAt])
  @@map("fiscal_receipts")
}

// ============================================
// Products (Snacks, Drinks, etc.)
// ============================================

model Product {
  id          Int      @id @default(autoincrement())
  name        String   @db.VarChar(255)
  description String?  @db.Text
  price       Float // վաճառքի գին
  costPrice   Float    @default(0) // ինքնաարժեք (շահույթի հաշվարկի համար)
  image       String?  @db.VarChar(500)
  category    String   @db.VarChar(50) // snack, drink, combo
  stock       Int      @default(0) // պահեստի առկա քանակ (հանվում է դրամարկղի վաճառքից)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orderItems   OrderItem[]
  units        ProductUnit[]
  bonusRewards BonusReward[]

  @@index([category])
  @@index([isActive])
  @@map("products")
}

// Ամեն ֆիզիկական միավոր՝ իր ունիկալ QR/գործարանային կոդով։
// Restock-ի ժամանակ ամեն միավոր սկանավորվում է, վաճառքից հետո մնում է
// բազայում (status = sold)՝ հարկային հաշվառման համար։
model ProductUnit {
  id            Int       @id @default(autoincrement())
  productId     Int
  qrCode        String    @unique @db.VarChar(255) // ամեն միավորի ունիկալ կոդ
  status        String    @default("in_stock") @db.VarChar(20) // in_stock, sold
  orderItemId   Int? // վաճառքի կապ (որ պատվերի հետ վաճառվեց)
  soldAt        DateTime?
  verifiedAt    DateTime? // ֆիզիկական ստուգում (ինվենտարիզացիա)
  // ՊԵԿ ուղարկված՝ շրջանառությունից դուրս (միավորը մնում է բազայում միշտ)
  pekReportedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([status])
  @@index([orderItemId])
  @@index([verifiedAt])
  @@index([pekReportedAt])
  @@map("product_units")
}

// ============================================
// Orders & Order Items
// ============================================

model Order {
  id            Int      @id @default(autoincrement())
  userId        Int
  totalAmount   Float
  status        String   @default("pending") @db.VarChar(50) // pending, completed, failed, cancelled
  paymentMethod String   @default("cash") @db.VarChar(50) // cash, card, counter (օնլայն ամրագրում՝ դրամարկղում վճարելու համար)
  amountPaid    Float? // կանխիկ վճարման դեպքում՝ հաճախորդի տված գումարը
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderItems        OrderItem[]
  tickets           Ticket[]
  fiscalReceipts    FiscalReceipt[]
  bonusTransactions BonusTransaction[]

  @@index([userId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          Int       @id @default(autoincrement())
  orderId     Int
  ticketId    Int? // Optional: if null, product belongs to order; if set, product belongs to specific ticket
  productId   Int
  quantity    Int       @default(1)
  price       Float // Վաճառքի գին պատվերի պահին
  costPrice   Float     @default(0) // Ինքնաարժեք պատվերի պահին (շահույթի հաշվարկ)
  fulfilledAt DateTime? // մուտքի ժամանակ պահեստից հանվել է

  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticket  Ticket?       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  product Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  units   ProductUnit[]

  @@index([orderId])
  @@index([ticketId])
  @@index([productId])
  @@index([fulfilledAt])
  @@map("order_items")
}

// ============================================
// Reviews
// ============================================

model Review {
  id        Int      @id @default(autoincrement())
  userId    Int
  movieId   Int
  rating    Int // 1-10
  comment   String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
  @@index([movieId])
  @@index([userId])
  @@map("reviews")
}

// ============================================
// FAQ
// ============================================

model FAQ {
  id        Int      @id @default(autoincrement())
  question  String   @db.Text
  answer    String   @db.Text
  order     Int      @default(0) // For ordering FAQs
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
  @@map("faqs")
}

// ============================================
// Contacts
// ============================================

model Contact {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  email     String?  @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  subject   String   @db.VarChar(255)
  message   String   @db.Text
  status    String   @default("new") @db.VarChar(50) // new, read, replied, archived
  userId    Int? // Optional: if user is logged in
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("contacts")
}

// ============================================
// Support Requests
// ============================================

model SupportRequest {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  phone     String   @db.VarChar(50)
  email     String?  @db.VarChar(255)
  subject   String   @db.VarChar(255)
  message   String   @db.Text
  status    String   @default("new") @db.VarChar(50) // new, in_progress, resolved, archived
  adminNote String?  @db.Text
  userId    Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user        User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  attachments SupportAttachment[]
  messages    SupportMessage[]

  @@index([status])
  @@index([userId])
  @@index([createdAt])
  @@map("support_requests")
}

model SupportMessage {
  id         Int      @id @default(autoincrement())
  requestId  Int
  senderType String   @db.VarChar(30) // customer, staff
  senderName String   @db.VarChar(255)
  message    String   @db.Text
  createdAt  DateTime @default(now())

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([senderType])
  @@index([createdAt])
  @@map("support_messages")
}

model SupportAttachment {
  id        Int      @id @default(autoincrement())
  requestId Int
  fileName  String   @db.VarChar(255)
  fileUrl   String   @db.VarChar(500)
  mimeType  String   @db.VarChar(120)
  size      Int
  createdAt DateTime @default(now())

  request SupportRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@map("support_attachments")
}

// ============================================
// Notifications (Admin)
// ============================================

model Notification {
  id        Int      @id @default(autoincrement())
  type      String   @db.VarChar(50) // online_ticket, online_product, box_office, cancellation, support
  title     String   @db.VarChar(255)
  message   String   @db.Text
  link      String?  @db.VarChar(500)
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================
// Premieres
// ============================================

model Premiere {
  id           Int      @id @default(autoincrement())
  movieId      Int
  premiereDate DateTime
  description  String?  @db.Text
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  movie Movie @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@index([movieId])
  @@index([premiereDate])
  @@index([isActive])
  @@map("premieres")
}

// ============================================
// Expenses (Admin)
// ============================================

// ============================================
// Package Bookings (Private Party, Corporate, VIP Date)
// ============================================

model PackageBooking {
  id            Int      @id @default(autoincrement())
  packageType   String   @db.VarChar(50) // private-party, corporate, vip-date, other
  customerName  String   @db.VarChar(255)
  customerPhone String   @db.VarChar(50)
  guestsCount   Int? // հյուրերի քանակ
  price         Float? // գին / կանխավճար (֏)
  notes         String?  @db.Text
  startTime     DateTime // պայմանավորված սկիզբ
  endTime       DateTime // հավանական ավարտ
  status        String   @default("confirmed") @db.VarChar(50) // pending, confirmed, cancelled
  createdById   Int? // ո՞վ է գրանցել (ադմին)
  createdBy     User?    @relation("PackageBookingCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([startTime])
  @@index([status])
  @@index([packageType])
  @@index([createdById])
  @@map("package_bookings")
}

// ============================================
// Բոնուսային համակարգ
// Միավորները վաստակվում են վճարված տոմսերից և ապրանքներից,
// ծախսվում են `BonusReward` կատալոգի պարգևների վրա։
// `User.bonusPoints`-ը միշտ հավասար է `BonusTransaction`-ների գումարին։
// ============================================

/** Համակարգի կանոնները՝ մեկ տողով (id=1), խմբագրվում է ադմին էջից։ */
model BonusSettings {
  id       Int     @id @default(1)
  isActive Boolean @default(true)

  // Վաստակ. միավոր = floor(գումար / amountPerPoint × multiplier-ներ)
  amountPerPoint    Float @default(100) // քանի՞ դրամի դիմաց 1 միավոր (բազա)
  ticketMultiplier  Float @default(0.5) // տոմս՝ 100֏ = 0.5 միավոր
  productMultiplier Float @default(1.5) // բուֆետը խրախուսելու համար

  // Միանվագ բոնուսներ
  welcomePoints         Int @default(50)
  birthdayPoints        Int @default(50)
  referralInviterPoints Int @default(25) // հրավիրողին
  referralInvitedPoints Int @default(20) // հրավիրվածին

  // Թույլ օրերի խթանում (0=կիրակի … 6=շաբաթ)
  bonusWeekdays      String @default("2,3") @db.VarChar(20)
  bonusDayMultiplier Float  @default(2)

  // Մակարդակներ՝ ըստ վճարված այցերի քանակի
  goldVisits         Int   @default(8)
  platinumVisits     Int   @default(15)
  goldMultiplier     Float @default(1.25)
  platinumMultiplier Float @default(1.5)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("bonus_settings")
}

/** Պարգևների կատալոգ՝ ինչի վրա կարելի է ծախսել միավորները։ */
model BonusReward {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(255)
  description String? @db.Text
  pointsCost  Int
  kind        String  @default("product") @db.VarChar(20) // product, ticket, discount
  productId   Int? // kind=product → որ ապրանքն է
  // kind=discount → զեղչի գումար (֏)։ product/ticket՝ 0 = ամբողջովին անվճար
  discountAmount Float   @default(0)
  isActive       Boolean @default(true)
  sortOrder      Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product      Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  transactions BonusTransaction[]

  @@index([isActive])
  @@index([productId])
  @@map("bonus_rewards")
}

/** Միավորների շարժի մատյան (audit trail)՝ ամեն մուտք/ելք։ */
model BonusTransaction {
  id           Int    @id @default(autoincrement())
  userId       Int
  type         String @db.VarChar(30) // earn, redeem, welcome, birthday, referral_inviter, referral_invited, admin_adjust, revoke
  points       Int // + վաստակ / − ծախս
  balanceAfter Int
  description  String @db.VarChar(255)

  orderId     Int?
  ticketId    Int?
  rewardId    Int?
  createdById Int? // ադմին/գանձապահ (ձեռքով ճշգրտում, դրամարկղում ծախս)

  createdAt DateTime @default(now())

  user      User         @relation("BonusOwner", fields: [userId], references: [id], onDelete: Cascade)
  createdBy User?        @relation("BonusCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  order     Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  ticket    Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  reward    BonusReward? @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
  @@index([orderId])
  @@index([ticketId])
  @@index([rewardId])
  @@index([createdById])
  @@map("bonus_transactions")
}

model Expense {
  id          Int      @id @default(autoincrement())
  title       String   @db.VarChar(255) // ինչի համար է ծախսը
  amount      Float // գումարը (֏)
  category    String   @default("other") @db.VarChar(50) // rent, utilities, salary, social_payment, stamp_duty, state_duty, ...
  spentBy     String   @db.VarChar(255) // ծախս վերցնողի անունը
  note        String?  @db.Text
  expenseDate DateTime // ո՞ր օրվա ծախսն է
  createdById Int? // ո՞վ է գրանցել (ադմին)
  createdBy   User?    @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([expenseDate])
  @@index([category])
  @@index([createdById])
  @@map("expenses")
}

// ============================================
// Հաշվապահություն / շրջհարկի գնահատական
// Համահունչ ՀԴՄ դասակարգմանը՝ տոմս 59.14, ապրանք 47.x
// ============================================

model AccountingSettings {
  id                       Int      @id @default(autoincrement())
  /// Տոմսի մասը, որ վճարվում է արտադրողին (գործնական P&L)՝ 0–100
  ticketProducerSharePercent Float  @default(50)
  /// Տարեկան շրջհարկի շեմ (AMD)՝ զգուշացման համար
  annualTurnoverThresholdAmd Float  @default(115000000)
  note                     String?  @db.Text
  updatedAt                DateTime @updatedAt
  createdAt                DateTime @default(now())

  @@map("accounting_settings")
}

/// Փաստաթղթավորված հաշիվներ՝ շրջհարկի նվազեցման համար
model TaxDocument {
  id            Int      @id @default(autoincrement())
  /// producer = ֆիլմ արտադրող, purchase = ապրանքի գնում, other = այլ փաստաթղթավորված ծախս
  kind          String   @db.VarChar(30)
  /// tickets = ԱԴԳ 59.14 (այլ գործունեություն), products = ԱԴԳ 47.x (առևտուր)
  stream        String   @db.VarChar(20)
  /// Ծախսի տեսակ՝ հոդ. 258 մաս 6-ի նվազեցվողության որոշման համար
  /// goods, service, fixed_asset, capital, depreciation, travel, representation, free_of_charge, other
  costType      String   @default("goods") @db.VarChar(30)
  /// false = օրենքով չի նվազեցնում շրջհարկը (հիմնական միջոց, գործուղում և այլն)
  deductible    Boolean  @default(true)
  title         String   @db.VarChar(255)
  supplierName  String?  @db.VarChar(255)
  supplierTin   String?  @db.VarChar(30)
  invoiceNumber String?  @db.VarChar(100)
  /// Ընդհանուր գումար (շրջհարկ վճարողի համար ծախս = ԱԱՀ-ով)
  amount        Float
  /// Տեղեկատվական՝ ՊԵԿ հաշվից
  amountExVat   Float?
  vatAmount     Float?
  documentDate  DateTime
  note          String?  @db.Text
  createdById   Int?
  createdBy     User?    @relation("TaxDocumentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([documentDate])
  @@index([kind])
  @@index([stream])
  @@index([costType])
  @@index([deductible])
  @@index([invoiceNumber])
  @@index([createdById])
  @@map("tax_documents")
}
